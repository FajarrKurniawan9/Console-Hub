        {
          "name": "Create Process (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pesanan produksi baru\",\n  \"description\": \"Buat pesanan, reservasi stok, mulai pengerjaan\",\n  \"compensate_on_failure\": true,\n  \"input_schema\": {\n    \"customer\": {\n      \"type\": \"string\",\n      \"required\": true,\n      \"label\": \"Pelanggan\"\n    },\n    \"sku\": {\n      \"type\": \"string\",\n      \"required\": true,\n      \"label\": \"SKU barang jadi\"\n    },\n    \"qty\": {\n      \"type\": \"integer\",\n      \"required\": true,\n      \"min\": 1,\n      \"label\": \"Jumlah\"\n    }\n  },\n  \"steps\": [\n    {\n      \"position\": 1,\n      \"name\": \"Buat pesanan di Produksi\",\n      \"console\": \"produksi\",\n      \"method\": \"POST\",\n      \"path\": \"/orders\",\n      \"body\": {\n        \"customer\": \"{{input.customer}}\",\n        \"lines\": [\n          {\n            \"sku\": \"{{input.sku}}\",\n            \"qty\": \"{{input.qty}}\"\n          }\n        ]\n      },\n      \"expect_status\": [201],\n      \"timeout_seconds\": 10,\n      \"max_retries\": 0,\n      \"on_failure\": \"stop\",\n      \"compensation\": {\n        \"method\": \"PATCH\",\n        \"path\": \"/orders/{{steps.1.response.body.order_no}}/status\",\n        \"body\": {\n          \"status\": \"DIBATALKAN\"\n        }\n      }\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/processes",
              "host": ["{{baseUrl}}"],
              "path": ["processes"]
            },
            "description": "Mendaftarkan definisi proses baru beserta langkah dan kompensasinya (Khusus Admin)."
          },
          "response": []
        },
        {
          "name": "Execute / Run Process",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 202) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.id) {",
                  "        pm.collectionVariables.set('runId', json.data.id);",
                  "        console.log('runId set to: ' + json.data.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input\": {\n    \"customer\": \"PT Maju Jaya\",\n    \"sku\": \"SKU-BJ-001\",\n    \"qty\": 10\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/processes/1/runs",
              "host": ["{{baseUrl}}"],
              "path": ["processes", "1", "runs"]
            },
            "description": "Menjalankan proses dengan input. Mengembalikan HTTP 202 Accepted dan id eksekusi (otomatis disimpan ke `{{runId}}`)."
          },
          "response": []
        }
      ]
    },
