{
  "info": {
    "_postman_id": "c7a8e2b1-4f90-4826-a0de-98a0d0e6c514",
    "name": "Console Hub Portal API",
    "description": "Koleksi API Postman untuk Portal Pengatur Proses Multi-Console (Console Hub).\n\nPrefix default: `{{baseUrl}}` (`http://localhost:8000/api/v1`).\nSetiap request yang membutuhkan autentikasi menggunakan Bearer token (`{{bearerToken}}`).\nMenjalankan request `Login (Admin)` atau `Login (Operator)` secara otomatis menyimpan token ke variabel koleksi `bearerToken`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api/v1",
      "type": "string"
    },
    {
      "key": "bearerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "consoleId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "runId",
      "value": "6f1c0e52-1234-5678-9abc-def012345678",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{bearerToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.token) {",
                  "        pm.collectionVariables.set('bearerToken', json.data.token);",
                  "        console.log('Bearer token saved successfully as Admin');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@consolehub.test\",\n  \"password\": \"adminpassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Login sebagai Admin. Token disimpan otomatis ke `{{bearerToken}}`."
          },
          "response": []
        },
        {
          "name": "Login (Operator)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.token) {",
                  "        pm.collectionVariables.set('bearerToken', json.data.token);",
                  "        console.log('Bearer token saved successfully as Operator');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"operator@consolehub.test\",\n  \"password\": \"operatorpassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Login sebagai Operator pengguna biasa."
          },
          "response": []
        },
        {
