meta {
  name: Deactivate Item
  type: http
  seq: 10
}

delete {
  url: {{gudang_url}}/api/v1/items/{{item_id}}?expected_version={{item_version}}
  body: none
  auth: none
}

params:query {
  expected_version: {{item_version}}
}

headers {
  X-Service-Key: {{gudang_service_key}}
}

script:post-response {
  if (res.status === 200 && res.body?.data?.version) {
    bru.setEnvVar("item_version", String(res.body.data.version));
  }
}

docs {
  `expected_version` MUST be sent as a query parameter.
}
