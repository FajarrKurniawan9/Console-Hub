meta {
  name: Sync Logs
  type: http
  seq: 2
}

post {
  url: {{portal_url}}/api/v1/admin/logs/sync
  body: json
  auth: inherit
}

body:json {
  {}
}

docs {
  Permission: `admin.logs.view`. Send `{}` to sync all active consoles, or `{"console_id": 1}` for a single console. Returns `202 Accepted`.
}
