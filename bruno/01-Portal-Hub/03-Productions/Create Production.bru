meta {
  name: Create Production
  type: http
  seq: 2
}

post {
  url: {{portal_url}}/api/v1/productions
  body: json
  auth: inherit
}

body:json {
  {
    "area": "Bandung",
    "production_type": "Pengemasan",
    "courier_id": null
  }
}

script:post-response {
  if (res.status === 201 && res.body?.data?.id) {
    bru.setEnvVar("production_id", res.body.data.id);
    bru.setEnvVar("production_version", String(res.body.data.version ?? 1));
  }
}

docs {
  Permission: `produksi.create`. Active `(area, production_type)` pairs must be unique. Optionally set `"courier_id": "{{person_id}}"`.
}
