meta {
  name: Get Production
  type: http
  seq: 3
}

get {
  url: {{portal_url}}/api/v1/productions/{{production_id}}
  body: none
  auth: inherit
}

script:post-response {
  if (res.status === 200 && res.body?.data?.version) {
    bru.setEnvVar("production_version", String(res.body.data.version));
  }
}

docs {
  Permission: `produksi.view`. `{id}` is a UUID.
}
