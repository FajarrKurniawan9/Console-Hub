meta {
  name: Update Item
  type: http
  seq: 4
}

patch {
  url: {{portal_url}}/api/v1/items/{{item_id}}
  body: json
  auth: inherit
}

body:json {
  {
    "expected_version": {{item_version}},
    "name": "Kotak Kemasan Updated",
    "quantity": 25,
    "unit": "pcs"
  }
}

script:post-response {
  if (res.status === 200 && res.body?.data?.version) {
    bru.setEnvVar("item_version", String(res.body.data.version));
  }
}

docs {
  Permission: `barang.update`. Uses optimistic locking via `expected_version`.
}
