meta {
  name: Create Item
  type: http
  seq: 2
}

post {
  url: {{portal_url}}/api/v1/items
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Kotak Kemasan",
    "kind": "kemasan",
    "production_id": null,
    "responsible_id": null,
    "quantity": 10,
    "unit": "pcs"
  }
}

script:post-response {
  if (res.status === 201 && res.body?.data?.id) {
    bru.setEnvVar("item_id", res.body.data.id);
    bru.setEnvVar("item_version", String(res.body.data.version ?? 1));
  }
}

docs {
  Permission: `barang.create`. Replace `null` with `"{{production_id}}"` or `"{{person_id}}"` to link records for tracking.
}
