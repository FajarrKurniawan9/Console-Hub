meta {
  name: Register Verify
  type: http
  seq: 8
}

post {
  url: {{portal_url}}/api/v1/auth/register/verify
  body: json
  auth: none
}

body:json {
  {
    "name": "{{register_name}}",
    "email": "{{register_email}}",
    "otp": "{{otp_code}}"
  }
}

script:post-response {
  if (res.status === 201 && res.body?.data?.token) {
    bru.setEnvVar("portal_token", res.body.data.token);
    bru.setEnvVar("register_resend_token", "");
  }
}

docs {
  Completes user registration (role `user`) and returns `201 Created` with a Sanctum token.
  Optional field: `"signup_token"` (from Google OAuth unregistered-email redirect) to link `google_id`.
}
