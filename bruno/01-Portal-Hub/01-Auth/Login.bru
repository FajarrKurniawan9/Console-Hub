meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{portal_url}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{login_email}}",
    "password": "{{login_password}}"
  }
}

script:post-response {
  if (res.status === 200 && res.body?.data?.token) {
    bru.setEnvVar("portal_token", res.body.data.token);
  }
}

docs {
  Throttled by `throttle:login`. Automatically stores `data.token` in `portal_token`.
}
