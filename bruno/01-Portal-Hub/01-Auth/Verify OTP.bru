meta {
  name: Verify OTP
  type: http
  seq: 6
}

post {
  url: {{portal_url}}/api/v1/auth/verify-otp
  body: json
  auth: none
}

body:json {
  {
    "email": "{{login_email}}",
    "otp": "{{otp_code}}"
  }
}

script:post-response {
  if (res.status === 200 && res.body?.data?.token) {
    bru.setEnvVar("portal_token", res.body.data.token);
    bru.setEnvVar("otp_resend_token", "");
  }
}

docs {
  Verifies a 6-digit login OTP (max 5 attempts). Automatically stores `data.token` in `portal_token`.
}
