meta {
  name: Google Redirect
  type: http
  seq: 9
}

get {
  url: {{portal_url}}/api/v1/auth/google/redirect
  body: none
  auth: none
}

docs {
  Returns a `302` redirect to Google OAuth consent screen (stateless Socialite flow).
  Normally opened in a browser; Google redirects back to `/api/v1/auth/google/callback`, which issues a short-lived `?code=...` (60s TTL) for `Google Exchange`.
}
