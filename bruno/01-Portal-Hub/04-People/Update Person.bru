meta {
  name: Update Person
  type: http
  seq: 4
}

patch {
  url: {{portal_url}}/api/v1/people/{{person_id}}
  body: json
  auth: inherit
}

body:json {
  {
    "expected_version": {{person_version}},
    "name": "Budi Santoso Updated",
    "role": "Kurir Senior"
  }
}

script:post-response {
  if (res.status === 200 && res.body?.data?.version) {
    bru.setEnvVar("person_version", String(res.body.data.version));
  }
}

docs {
  Permission: `personel.update`.
}
