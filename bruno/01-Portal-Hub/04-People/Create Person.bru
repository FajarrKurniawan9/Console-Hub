meta {
  name: Create Person
  type: http
  seq: 2
}

post {
  url: {{portal_url}}/api/v1/people
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Budi Santoso",
    "role": "Kurir"
  }
}

script:post-response {
  if (res.status === 201 && res.body?.data?.id) {
    bru.setEnvVar("person_id", res.body.data.id);
    bru.setEnvVar("person_version", String(res.body.data.version ?? 1));
  }
}

docs {
  Permission: `personel.create`.
}
